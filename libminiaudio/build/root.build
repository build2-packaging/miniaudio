# Uncomment to suppress warnings coming from external libraries.
#
#c.internal.scope = current

using c
using c.objc

# Homebrew GCC cannot parse Apple Core Audio headers (Clang blocks syntax).
#
if ($c.target.class == 'macos' && $c.id == 'gcc')
  fail 'macOS requires Clang, GCC cannot parse Apple Core Audio headers'

h{*}: extension = h
c{*}: extension = c

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $c.target
